# NEXORA server settings. Copy to .env in the repository root (git-ignored) and fill
# in the values, or set the same variables in your host's environment.

# PostgreSQL connection. The user must own the NEXORA tables (or be a superuser)
# and be a member of the anon / authenticated / service_role roles, which
# db/platform.sql arranges. Add ?sslmode=require for a remote database.
DATABASE_URL=postgres://nexora:change-me@localhost:5432/nexora

# Signs the browser session tokens. At least 32 random characters:
#   openssl rand -hex 32
# Changing it signs everyone out.
JWT_SECRET=

# Teacher portal sign-in codes (docs/teacher-login.md).
TEACHER_LOGIN_CODE=
TEACHER_ACCESS_CODE=

# Shared secret of the RFID readers; the same value goes in each reader's
# config.h. At least 32 random characters: openssl rand -hex 24
PULSE_RFID_DEVICE_SECRET=

PORT=8787

# Browser origins allowed to call the API (comma-separated). "null" is the
# Android apps, which load pages from file://. This is the default:
# NEXORA_ALLOWED_ORIGINS=https://codecrew-lab.github.io,null,http://localhost:3000,http://127.0.0.1:5500

# Set to 1 when the server sits behind a reverse proxy (nginx, Caddy, a PaaS)
# that sets X-Forwarded-For, so rate limits see the real client address.
# Leave unset when the server is reachable directly.
# TRUST_PROXY=1

# Maximum pooled database connections (default 10).
# DATABASE_POOL_MAX=10

# Web push notifications (optional; without both keys the feature is off).
# Generate a pair with: cd server && npx web-push generate-vapid-keys
# The public key must also be set in push-notifications.js. Changing the pair
# makes every device subscribe again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Where a tapped notification opens (default: the GitHub Pages site).
# NEXORA_APP_URL=https://codecrew-lab.github.io/nexora/
