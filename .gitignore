# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/
app/build/
.gradle/

# Android Studio / IntelliJ IDEA
.idea/
*.iml
.navigation/
captures/
.externalNativeBuild
.cxx/

# Local configuration file (sdk path, etc)
local.properties

# OS generated files
.DS_Store
Thumbs.db

# Firmware secrets: copy config.example.h to config.h locally, never commit it
hardware/**/config.h

# Stray local Arduino sketches at the repo root can contain Wi-Fi passwords and
# the device secret. Firmware lives in hardware/.
/*.ino

# Server secrets (database password, signing key, sign-in codes). This repository
# is public and GitHub Pages serves its root, so these must never be committed.
.env
.env.*
!.env.example
server/node_modules/

# Push notification keys (never commit)
.secrets/
